{
  "enabled": true,
  "points": {
    "tool.risk": "shadow",
    "tool.approval": "off",
    "agent_route": "shadow"
  },
  "tiers": ["jev"],
  "routes": {},
  "judges": {
    "relay": {
      "type": "typesafe",
      "baseUrl": "https://relay.example.com/v1/systemone",
      "model": "jev-1.13",
      "apiKeyEnv": "RELAY_KEY"
    },
    "lab": {
      "type": "http",
      "baseUrl": "http://10.0.0.5:9000/evaluate",
      "timeoutMs": 2000
    },
    "fast": {
      "type": "llm",
      "baseUrl": "https://chat.example.com/v1",
      "model": "qwen-plus",
      "apiKeyEnv": "EXAMPLE_LLM_KEY",
      "timeoutMs": 4000
    }
  },
  "agentRoute": {
    "candidates": [
      "IPP",
      "Codex_Agent",
      "PCB_Agent",
      "Designer",
      "PM",
      "PersonalHelper",
      "SkillEvolver_Agent",
      "default"
    ],
    "descriptions": {
      "IPP": "patents, literature, Office documents",
      "Codex_Agent": "software code, CI, agent frameworks",
      "PCB_Agent": "circuit design, simulation, mechanical CAD, firmware",
      "Designer": "charts, diagrams, images, video, slide visuals",
      "PM": "PRD, plans, estimates, progress risk",
      "PersonalHelper": "life tasks: travel, maps, orders, media",
      "SkillEvolver_Agent": "skill creation, evaluation, evolution",
      "default": "orchestrator answers directly"
    },
    "threshold": 0.6,
    "askMin": 0.45,
    "margin": 0.1
  },
  "thresholds": {
    "yes": 0.85,
    "no": 0.15,
    "minProbability": 0.6,
    "risk": 0.85
  },
  "approvalTools": ["execute_shell_command", "run_command"],
  "skipTools": ["jev_ask", "jev_route", "jev_ledger"],
  "timeoutMs": 4000,
  "recordState": false,
  "stateChars": 4000,
  "ledgerTail": 20
}
